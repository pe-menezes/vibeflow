---
import '../styles/genius/genius-tudo.css';
import '../styles/genius/genius-noite.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: string;
}

const { title, description, lang } = Astro.props;
// astro.config.mjs sets `site`; every absolute address on the page comes from it.
const site = Astro.site!;
const canonicalUrl = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    <!-- Before the first paint: the saved theme (either way) and whether motion is allowed. -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') html.dataset.theme = saved;
        } catch (e) {}
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) html.classList.add('motion-ok');
      })();
    </script>

    <title>{title}</title>

    <!-- OG Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <!-- Fonts are self-hosted (public/fonts); only the title face is preloaded. -->
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site).href} />
    <link rel="alternate" hreflang="pt-BR" href={new URL('/pt-br/', site).href} />
  </head>
  <body data-gx-acento="violet">
    <slot />

    <script>
      import { iniciar } from '../scripts/genius/genius.js';
      iniciar();
    </script>
  </body>
</html>
