---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The title, with the term "spec-driven" found in the title itself and highlighted.
const title = t.heroTitle.replace(/\n/g, ' ');
const found = /spec-driven/i.exec(title);
const [titleBefore, titleTerm, titleAfter] = found
  ? [title.slice(0, found.index), found[0], title.slice(found.index + found[0].length)]
  : [title, '', ''];

// The spec card and the verdict reuse the facts of the pipeline steps (gen-spec, implement, audit).
const stepItems = (desc: string) => desc.replace(/^✓\s*/, '').split(' · ');
const specName = /"([^"]+)"/.exec(t.heroQuickStart2Cmd)?.[1];
const specLabel = specName ? `spec · ${specName}` : 'spec';
const specItems = stepItems(t.heroQuickStart2Desc);
const verdict = t.heroQuickStart4Desc.split('.')[0];
const verdictNote = stepItems(t.heroQuickStart3Desc).slice(0, 2).join(' · ');
---

<section class="hero">
  <div class="container hero-text">
    <div class="hero-head rise">
      <div class="hero-kicker">
        <p class="gx-rotulo">{t.heroEyebrow}</p>
      </div>
      <h1 class="hero-title">
        {titleBefore}{titleTerm && <em><mark class="hero-mark">{titleTerm}</mark></em>}{titleAfter}
      </h1>
    </div>
    <div class="hero-side rise" style="--rise-i: 2">
      <p class="hero-lede"><b>{t.heroSubtitle}</b></p>
      <div class="hero-actions">
        <a class="gx-btn gx-btn--primario gx-btn--g" href={`/${lang}/#how`}>
          {t.heroCta}<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
        <a class="gx-btn gx-btn--g" href={`/${lang}/#editions`}>{t.heroInstall}</a>
      </div>
    </div>
  </div>

  <div class="flow-band" role="img" aria-label={t.heroFlowLabel}>
    <canvas class="flow-canvas" data-flow="hero" aria-hidden="true"></canvas>
    <p class="flow-note flow-note--before" aria-hidden="true">{t.heroFlowBefore}</p>
    <p class="flow-note flow-note--after" aria-hidden="true">{t.heroFlowAfter}</p>
    <div class="gx-cartao flow-spec" aria-hidden="true">
      <p class="gx-rotulo">{specLabel}</p>
      <ul class="flow-spec__list">
        {specItems.map((item) => <li><i class="check"></i>{item}</li>)}
      </ul>
    </div>
    <div class="flow-verdict" aria-hidden="true">
      <span class="gx-chip gx-chip--marcado">{verdict}</span>
      <small>{verdictNote}</small>
    </div>
  </div>
</section>

<script>
  import { createFlow } from '../lib/flow.js';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-flow="hero"]').forEach((canvas) => createFlow(canvas));
</script>

<style>
  /* Title on the left and the call on the right, so the flow band fits in the first screen. */
  .hero-text {
    display: grid;
    gap: var(--s-5) var(--s-7);
    padding-top: clamp(24px, 4.4vw, 60px);
  }
  @media (min-width: 980px) {
    .hero-text {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      align-items: end;
    }
    .hero-side {
      padding-bottom: 0.5rem;
    }
  }

  .hero-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .hero-title {
    max-width: 15ch;
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6.6vw, 5.6rem);
    font-weight: 400;
    letter-spacing: -0.034em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .hero-title em {
    font-style: italic;
  }
  /* The highlighter: a band of the accent behind the lower half of the term. At rest it is drawn;
     with motion allowed it runs once on load. The text is always readable. */
  .hero-mark {
    padding: 0 0.05em;
    background: linear-gradient(var(--accent-halo), var(--accent-halo)) no-repeat 0 82% / 100% 0.46em;
    color: inherit;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion-ok) .hero-mark {
      animation: mark var(--d-5) var(--ease-swap) var(--d-3) both;
    }
  }
  @keyframes mark {
    from { background-size: 0% 0.46em; }
    to { background-size: 100% 0.46em; }
  }

  /* The call is the subtitle alone, one step above the old size (the approved mock-up). */
  .hero-lede {
    max-width: 22ch;
    color: var(--ink-3);
    font-size: clamp(1.25rem, 2.1vw, 1.6rem);
    line-height: 1.3;
  }
  .hero-lede b {
    color: var(--ink);
    font-weight: 500;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .arrow {
    width: 16px;
    height: 16px;
    transition: transform var(--d-3) var(--ease-out);
  }
  .gx-btn:hover .arrow {
    transform: translateX(4px);
  }
  .arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The flow band, full bleed. The spec card sits on the gate (54% of the width, 50% on narrow
     screens), the same place heroGeometry() in src/lib/flow.js orders the lines. */
  .flow-band {
    position: relative;
    height: clamp(240px, 27vw, 360px);
    margin-top: clamp(20px, 3vw, 40px);
  }
  .flow-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The two notes in the bottom corners, on a paper ground: the loose side, then the ordered one. */
  .flow-note {
    position: absolute;
    bottom: var(--s-2);
    padding: 1px var(--s-2);
    border-radius: var(--r-1);
    background: var(--bg);
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .flow-note--before {
    left: max(16px, 4%);
  }
  .flow-note--after {
    right: max(16px, 4%);
    color: var(--accent-text);
  }
  .flow-spec {
    position: absolute;
    top: 50%;
    left: 54%;
    width: clamp(158px, 21vw, 256px);
    padding: clamp(12px, 1.6vw, 20px);
    transform: translate(-50%, -50%);
    box-shadow: var(--e-2);
  }
  .flow-spec__list {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-3);
    padding: 0;
    list-style: none;
    font-size: clamp(.95rem, 1.3vw, 1.05rem);
    line-height: 1.3;
  }
  .flow-spec__list li {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .check {
    flex: none;
    width: 0.58em;
    height: 0.34em;
    border: solid var(--accent);
    border-width: 0 0 2px 2px;
    transform: translateY(-0.22em) rotate(-45deg);
  }
  .flow-verdict {
    position: absolute;
    top: 50%;
    right: max(14px, 4%);
    display: grid;
    justify-items: end;
    gap: var(--s-2);
    transform: translateY(-50%);
  }
  .flow-verdict small {
    padding: 1px var(--s-1);
    border-radius: var(--r-1);
    background: var(--bg);
    color: var(--ink-3);
    font-size: var(--fs-meta);
  }
  @media (max-width: 559px) {
    .flow-spec {
      left: 50%;
    }
    .flow-verdict small {
      display: none;
    }
  }
</style>
