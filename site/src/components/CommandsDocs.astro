---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const commands = [
  {
    id: 'analyze',
    name: 'analyze',
    tagline: t.feat1For,
    desc: t.cmdAnalyzeDesc,
    usage: t.cmdAnalyzeUsage,
    flags: [
      { label: lang === 'en' ? '(no flags)' : '(sem flags)', desc: t.cmdAnalyzeFlagDefault },
      { label: '--fresh', desc: t.cmdAnalyzeFlagFresh },
      { label: '--scope <path>', desc: t.cmdAnalyzeFlagScope },
      { label: '--interactive', desc: t.cmdAnalyzeFlagInteractive },
      { label: '--satellite <url>', desc: t.cmdAnalyzeFlagSatellite },
      { label: '--measure', desc: t.cmdAnalyzeFlagMeasure },
      { label: lang === 'en' ? 'Tests and pitfalls' : 'Testes e pitfalls', desc: t.cmdAnalyzeTests },
      { label: lang === 'en' ? 'Import protection' : 'Proteção de importados', desc: t.cmdAnalyzeImportProtection },
    ],
    output: t.cmdAnalyzeOutput,
  },
  {
    id: 'discover',
    name: 'discover',
    tagline: t.feat5For,
    desc: t.cmdDiscoverDesc,
    usage: t.cmdDiscoverUsage,
    flags: [
      { label: lang === 'en' ? 'Quick round' : 'Round rápido', desc: t.cmdDiscoverModeQuick },
      { label: lang === 'en' ? 'Complete flow' : 'Fluxo completo', desc: t.cmdDiscoverModeComplete },
      { label: '## Clarifications', desc: t.cmdDiscoverClarifications },
    ],
    output: t.cmdDiscoverOutput,
  },
  {
    id: 'gen-spec',
    name: 'gen-spec',
    tagline: t.feat2For,
    desc: t.cmdGenSpecDesc,
    usage: t.cmdGenSpecUsage,
    flags: [
      { label: lang === 'en' ? 'From PRD' : 'A partir de PRD', desc: t.cmdGenSpecInputPrd },
      { label: lang === 'en' ? 'From description' : 'A partir de descrição', desc: t.cmdGenSpecInputDirect },
      { label: lang === 'en' ? 'PRD validation' : 'Validação de PRD', desc: t.cmdGenSpecValidation },
      { label: 'Auto-split', desc: t.cmdGenSpecAutoSplit },
      { label: '[NEEDS CLARIFICATION: …]', desc: t.cmdGenSpecMarkers },
      { label: '## Clarifications', desc: t.cmdGenSpecClarifications },
      { label: 'Scenarios:', desc: t.cmdGenSpecScenarios },
      { label: 'Risk code:', desc: t.cmdGenSpecRiskCode },
      { label: lang === 'en' ? 'No one to answer' : 'Sem ninguém para responder', desc: t.cmdGenSpecHeadless },
      { label: lang === 'en' ? 'Literals' : 'Literais', desc: t.cmdGenSpecLiterals },
    ],
    output: t.cmdGenSpecOutput,
  },
  {
    id: 'implement',
    name: 'implement',
    tagline: t.feat3For,
    desc: t.cmdImplementDesc,
    usage: t.cmdImplementUsage,
    flags: [
      { label: lang === 'en' ? 'Phase 0' : 'Fase 0', desc: t.cmdImplementPhase0 },
      { label: lang === 'en' ? 'Phase 1' : 'Fase 1', desc: t.cmdImplementPhase1 },
      { label: lang === 'en' ? 'Phase 2' : 'Fase 2', desc: t.cmdImplementPhase2 },
      { label: lang === 'en' ? 'Phase 3' : 'Fase 3', desc: t.cmdImplementPhase3 },
      { label: lang === 'en' ? 'Phase 4' : 'Fase 4', desc: t.cmdImplementPhase4 },
      { label: lang === 'en' ? 'Phase 5' : 'Fase 5', desc: t.cmdImplementPhase5 },
      { label: lang === 'en' ? 'Phase 6' : 'Fase 6', desc: t.cmdImplementPhase6 },
      { label: lang === 'en' ? 'Phase 7' : 'Fase 7', desc: t.cmdImplementPhase7 },
      { label: lang === 'en' ? 'Phase 8' : 'Fase 8', desc: t.cmdImplementPhase8 },
    ],
    loop: {
      label: t.cmdLoopMode,
      flags: [
        { label: '--loop', desc: t.cmdImplementLoop },
        { label: 'loop: true', desc: t.cmdImplementLoopConfig },
        { label: '--no-loop', desc: t.cmdImplementNoLoop },
        { label: t.cmdImplementLoopStopLabel, desc: t.cmdImplementLoopStop },
      ],
      link: t.cmdImplementLoopLink,
    },
    output: t.cmdImplementOutput,
    note: t.cmdImplementNote,
  },
  {
    id: 'prompt-pack',
    name: 'prompt-pack',
    tagline: t.feat6For,
    desc: t.cmdPromptPackDesc,
    usage: t.cmdPromptPackUsage,
    flags: [
      { label: 'Agent-agnostic', desc: t.cmdPromptPackAgnostic },
      { label: lang === 'en' ? 'Embedded patterns' : 'Padrões embutidos', desc: t.cmdPromptPackEmbedded },
      { label: lang === 'en' ? 'Validation' : 'Validação', desc: t.cmdPromptPackValidation },
    ],
    output: t.cmdPromptPackOutput,
  },
  {
    id: 'audit',
    name: 'audit',
    tagline: t.feat4For,
    desc: t.cmdAuditDesc,
    usage: t.cmdAuditUsage,
    flags: [
      { label: lang === 'en' ? 'Review package' : 'Pacote de revisão', desc: t.cmdAuditPackage },
      { label: '--reaudit <round-commit>', desc: t.cmdAuditReaudit },
      { label: '--probes', desc: t.cmdAuditProbes },
      { label: lang === 'en' ? 'Severity and cause' : 'Severidade e causa', desc: t.cmdAuditSeverity },
      { label: 'PASS', desc: t.cmdAuditVerdictPass },
      { label: 'PARTIAL', desc: t.cmdAuditVerdictPartial },
      { label: 'FAIL', desc: t.cmdAuditVerdictFail },
      { label: lang === 'en' ? 'Incremental fix' : 'Fix incremental', desc: t.cmdAuditIncremental },
      { label: '--consolidate-hotfixes', desc: t.cmdAuditConsolidate },
    ],
    output: t.cmdAuditOutput,
  },
  {
    id: 'quick',
    name: 'quick',
    tagline: t.feat7For,
    desc: t.cmdQuickDesc,
    usage: t.cmdQuickUsage,
    flags: [
      { label: lang === 'en' ? 'Budget ≤4 files' : 'Budget ≤4 arquivos', desc: t.cmdQuickBudget },
      { label: lang === 'en' ? 'Ephemeral spec' : 'Spec efêmera', desc: t.cmdQuickEphemeral },
      { label: lang === 'en' ? 'When to use' : 'Quando usar', desc: t.cmdQuickWhen },
    ],
    output: t.cmdQuickOutput,
  },
  {
    id: 'hotfix',
    name: 'hotfix',
    tagline: t.feat10For,
    desc: t.cmdHotfixDesc,
    usage: t.cmdHotfixUsage,
    flags: [
      { label: lang === 'en' ? 'Trace doc' : 'Doc de rastro', desc: t.cmdHotfixTrace },
      { label: lang === 'en' ? 'Red proof' : 'Prova vermelha', desc: t.cmdHotfixRedProof },
      { label: lang === 'en' ? 'done or HALT' : 'done ou HALT', desc: t.cmdHotfixHalts },
      { label: lang === 'en' ? 'verified status' : 'Status verified', desc: t.cmdHotfixVerified },
      { label: lang === 'en' ? 'Consolidation' : 'Consolidação', desc: t.cmdHotfixConsolidate },
      { label: lang === 'en' ? 'When to use' : 'Quando usar', desc: t.cmdHotfixWhen },
    ],
    output: t.cmdHotfixOutput,
  },
  {
    id: 'teach',
    name: 'teach',
    tagline: lang === 'en' ? 'Teach your project' : 'Ensine seu projeto',
    desc: t.cmdTeachDesc,
    usage: t.cmdTeachUsage,
    flags: [
      { label: lang === 'en' ? 'Pattern correction' : 'Correção de padrão', desc: t.cmdTeachCat1 },
      { label: lang === 'en' ? 'New convention' : 'Nova convenção', desc: t.cmdTeachCat2 },
      { label: lang === 'en' ? 'Architecture decision' : 'Decisão arquitetural', desc: t.cmdTeachCat3 },
      { label: lang === 'en' ? 'New pattern' : 'Padrão novo', desc: t.cmdTeachCat4 },
      { label: '--from', desc: t.cmdTeachCat5 },
      { label: lang === 'en' ? 'Conflict detection' : 'Detecção de conflito', desc: t.cmdTeachConflict },
    ],
    output: t.cmdTeachOutput,
  },
  {
    id: 'stats',
    name: 'stats',
    tagline: lang === 'en' ? 'Track quality' : 'Acompanhe qualidade',
    desc: t.cmdStatsDesc,
    usage: t.cmdStatsUsage,
    flags: [
      { label: lang === 'en' ? 'Metrics' : 'Métricas', desc: t.cmdStatsMetrics },
      { label: lang === 'en' ? 'Trend' : 'Tendência', desc: t.cmdStatsTrend },
      { label: '### Loop', desc: t.cmdStatsLoop },
      { label: lang === 'en' ? 'In progress' : 'Em andamento', desc: t.cmdStatsInProgress },
    ],
    output: t.cmdStatsOutput,
  },
];
---

<section class="commands-docs">
  <div class="container doc">
    <header class="doc-head">
      <a href={`/${lang}/`} class="gx-link doc-back">{t.cmdBackToHome}</a>
      <p class="gx-rotulo doc-label">{t.cmdPageEyebrow}</p>
      <h1 class="doc-title">{t.cmdPageTitle}</h1>
      <p class="doc-lede">{t.cmdPageSubtitle}</p>
    </header>

    <div class="doc-body">
      <nav class="doc-toc doc-toc--mono" data-doc-toc aria-label={t.cmdTocLabel}>
        <p class="gx-rotulo">{t.cmdTocLabel}</p>
        <ol>
          {commands.map((cmd) => (
            <li><a href={`#${cmd.id}`}>{cmd.name}</a></li>
          ))}
        </ol>
      </nav>

      <div class="doc-main">
        {commands.map((cmd) => (
          <article id={cmd.id} class="doc-entry">
            <header class="entry-head">
              <h2 class="entry-name">{cmd.name}</h2>
              <p class="gx-rotulo">{cmd.tagline}</p>
            </header>

            <p class="entry-text">{cmd.desc}</p>

            <div class="entry-block">
              <p class="gx-rotulo entry-label">{t.cmdUsage}</p>
              <pre class="gx-escuro entry-code"><code>{cmd.usage}</code></pre>
            </div>

            <div class="entry-block">
              <p class="gx-rotulo entry-label">{cmd.id === 'implement' ? t.cmdPipeline : t.cmdFlags}</p>
              <dl class="entry-defs">
                {cmd.flags.map((flag) => (
                  <div class="entry-def">
                    <dt><code class="gx-chip">{flag.label}</code></dt>
                    <dd>{flag.desc}</dd>
                  </div>
                ))}
              </dl>
            </div>

            {cmd.loop && (
              <div class="entry-block">
                <p class="gx-rotulo entry-label">{cmd.loop.label}</p>
                <dl class="entry-defs">
                  {cmd.loop.flags.map((flag) => (
                    <div class="entry-def">
                      <dt><code class="gx-chip">{flag.label}</code></dt>
                      <dd>{flag.desc}</dd>
                    </div>
                  ))}
                </dl>
                <p class="entry-more"><a href={`/${lang}/#loop`} class="gx-link">{cmd.loop.link}</a></p>
              </div>
            )}

            <dl class="entry-defs entry-output">
              <div class="entry-def">
                <dt class="gx-rotulo">{t.cmdOutput}</dt>
                <dd><code>{cmd.output}</code></dd>
              </div>
            </dl>

            {cmd.note && <p class="entry-note">{cmd.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Marks the index link of the entry being read. Without this script the index is a plain list of
  // links and every entry is already on the page; the mark is an accent, never a gate.
  //
  // The entry being read is the last one whose top has passed the reading line, which sits just
  // below the scroll margin a jump from the index lands an entry at. Near the page end the line
  // slides down, at most half as fast as the page scrolls, so the entries too short or too late to
  // ever reach the top still come up one by one, in order, and the last one is current at the very
  // bottom. A jump from the index marks the entry jumped to, wherever the page end stops the scroll,
  // and the mark stays until the reader scrolls on.
  document.querySelectorAll<HTMLElement>('[data-doc-toc]').forEach((toc) => {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (!targets.length) return;

    const setCurrent = (id: string) => {
      links.forEach((a, key) => {
        if (key === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };

    // A few pixels below the scroll margin, so rounding never leaves a landed entry above the line.
    const SLACK = 8;
    const reading = () => {
      const y = window.scrollY;
      const end = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const tops = targets.map((el) => el.getBoundingClientRect().top);
      const line0 = (parseFloat(window.getComputedStyle(targets[0]).scrollMarginTop) || 0) + SLACK;
      // Where the line has to be at the page end for the last entry to be current, and how far it
      // has to travel to get there; it travels over twice that distance of scrolling.
      const extra = tops[tops.length - 1] + y - end + 1 - line0;
      let line = line0;
      if (extra > 0 && end > 0) {
        const span = Math.min(end, 2 * extra);
        line += extra * Math.min(1, Math.max(0, 1 - (end - y) / span));
      }
      let current = targets[0].id;
      tops.forEach((top, i) => {
        if (top <= line) current = targets[i].id;
      });
      return current;
    };

    // After a jump from the index the entry jumped to stays current: through the jump's own smooth
    // scroll (until scrolling pauses), and then until the page scrolls again. A scroll gesture of
    // the reader's own (wheel, touch, scroll key) lets go of it at once, paused or not.
    const SETTLE_MS = 150;
    const SCROLL_KEYS = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Spacebar']);
    let jumpedTo = '';
    let restedAt = -1;
    let settleTimer = 0;
    const settle = () => {
      window.clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => {
        restedAt = window.scrollY;
      }, SETTLE_MS);
    };
    const jump = (id: string) => {
      if (!links.has(id)) return;
      jumpedTo = id;
      restedAt = -1;
      setCurrent(id);
      settle();
    };
    const letGo = () => {
      window.clearTimeout(settleTimer);
      jumpedTo = '';
    };

    let frame = 0;
    const update = () => {
      frame = 0;
      if (jumpedTo) {
        if (restedAt < 0 || Math.abs(window.scrollY - restedAt) < 2) return;
        jumpedTo = '';
      }
      setCurrent(reading());
    };
    const onScroll = () => {
      if (jumpedTo && restedAt < 0) settle();
      else if (!frame) frame = window.requestAnimationFrame(update);
    };

    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element | null)?.closest?.('a[href^="#"]');
      links.forEach((link, id) => {
        if (link === a) jump(id);
      });
    });
    window.addEventListener('hashchange', () => jump(decodeURIComponent(window.location.hash.slice(1))));
    window.addEventListener('wheel', letGo, { passive: true });
    window.addEventListener('touchstart', letGo, { passive: true });
    window.addEventListener('keydown', (e) => {
      if (SCROLL_KEYS.has(e.key)) letGo();
    });
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);

    const landed = decodeURIComponent(window.location.hash.slice(1));
    if (links.has(landed)) jump(landed);
    else update();
  });
</script>

<style>
  /* An editorial document: the head, then an index beside a reading column on wide screens. */
  .doc {
    /* The measure of running text, in em so it follows each block's font size: about 66 characters
       of this face per line (counted in the browser; a `ch` is the width of "0" and holds more). */
    --doc-measure: 31.5em;
    padding-block: clamp(32px, 5vw, 72px) var(--s-8);
  }

  .doc-head {
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--rule-soft);
  }
  .doc-back {
    font-size: var(--fs-ui);
  }
  .doc-label {
    margin-top: var(--s-6);
  }
  .doc-title {
    max-width: 18ch;
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }
  .doc-lede {
    max-width: var(--doc-measure);
    margin-top: var(--s-4);
    color: var(--ink-3);
    font-size: var(--fs-lede);
    line-height: 1.45;
  }

  .doc-body {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  .doc-main {
    min-width: 0;
    max-width: 50rem;
  }

  /* The index: a wrapped list on top on narrow screens, a sticky column with a rule on wide ones. */
  .doc-toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-3);
    list-style: none;
  }
  .doc-toc a {
    color: var(--ink-3);
    font-size: var(--fs-ui);
    transition: color var(--d-2) var(--ease-out), border-color var(--d-2) var(--ease-out);
  }
  .doc-toc--mono a {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .doc-toc a:hover,
  .doc-toc a[aria-current] {
    color: var(--ink);
  }

  @media (min-width: 980px) {
    .doc-body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--s-8);
      align-items: start;
      margin-top: var(--s-7);
    }
    .doc-toc {
      position: sticky;
      top: var(--s-6);
    }
    .doc-toc ol {
      display: grid;
      gap: 0;
      border-left: 1px solid var(--rule-soft);
    }
    .doc-toc a {
      display: block;
      margin-left: -1px;
      padding: var(--s-1) 0 var(--s-1) var(--s-3);
      border-left: 2px solid transparent;
    }
    .doc-toc a[aria-current] {
      border-left-color: var(--accent);
    }
  }

  /* One entry per command: one idea per block, a rule between entries, generous room. */
  .doc-entry {
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule-soft);
    scroll-margin-top: var(--s-5);
  }
  .doc-entry:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
  }
  .entry-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .entry-text {
    max-width: var(--doc-measure);
    margin-top: var(--s-4);
    color: var(--ink-2);
    line-height: 1.6;
  }

  .entry-block {
    margin-top: var(--s-6);
  }
  .entry-label {
    margin-bottom: var(--s-3);
  }

  /* Code on the dark stage; it wraps instead of scrolling, so no part of a command is out of view. */
  .entry-code {
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-2);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .entry-code code {
    font-size: inherit;
  }

  /* Details as definition rows, a rule between them: the chip on the left, the text on the right. */
  .entry-def {
    display: grid;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule-soft);
  }
  .entry-def:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  @media (min-width: 720px) {
    .entry-def {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .entry-def dt .gx-chip {
    font-size: var(--fs-data);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .entry-def dd {
    max-width: var(--doc-measure);
    color: var(--ink-3);
    line-height: 1.6;
  }

  .entry-more {
    margin-top: var(--s-4);
    font-size: var(--fs-ui);
  }

  .entry-output {
    margin-top: var(--s-6);
  }
  .entry-output dd code {
    color: var(--ink-2);
    font-size: var(--fs-meta);
    overflow-wrap: anywhere;
  }

  .entry-note {
    max-width: var(--doc-measure);
    margin-top: var(--s-5);
    padding-left: var(--s-4);
    border-left: 2px solid var(--accent-edge);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-style: italic;
    line-height: 1.35;
  }
</style>
