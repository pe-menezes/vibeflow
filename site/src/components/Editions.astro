---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import InlineCode from './InlineCode.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Display markup for a command: pieces that never break inside (`pe-menezes`,
// `setup-vibeflow@latest`, `--cursor`), joined by spaces or by "/" plus <wbr>, so the
// line breaks only there (a leading "/", as in `/plugin`, gets no break after it).
// The copy button keeps the exact command in data-copy.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const cmdHtml = (cmd: string) =>
  cmd
    .split(' ')
    .map((word) =>
      word
        .split(/(?<=[^/]\/)/)
        .map((piece) => `<span class="ed-cmd-part">${escapeHtml(piece)}</span>`)
        .join('<wbr>'),
    )
    .join(' ');
---

<section class="section editions" id="editions">
  <div class="container">
    <p class="gx-rotulo ed-label">{t.editionsLabel}</p>
    <h2 class="section-title">{t.editionsTitle2}</h2>
    <p class="section-sub">{t.editionsSubtitle2}</p>

    <!-- Three answers before the rows: cost, code, first command. Titles are dt, not h3: the h3 of
         this section are the six agents. -->
    <dl class="ed-answers">
      <div class="ed-answer">
        <dt>{t.editionsCostTitle}</dt>
        <dd><InlineCode text={t.editionsCostBody} /></dd>
      </div>
      <div class="ed-answer">
        <dt>{t.editionsCodeTitle}</dt>
        <dd><InlineCode text={t.editionsCodeBody} /></dd>
      </div>
      <div class="ed-answer">
        <dt>{t.editionsFirstTitle}</dt>
        <dd><InlineCode text={t.editionsFirstBody} /></dd>
      </div>
    </dl>

    <!-- One row per agent, in this order: Codex, Hermes, Claude Code, Cursor, Copilot, OpenCode. -->
    <ul class="gx-lista ed-list">
      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.codexTitle}</h3>
          <p class="ed-desc">{t.codexDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.codexInstall)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.codexInstall} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.codexInstall2)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.codexInstall2} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
        </div>
      </li>

      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.hermesTitle}</h3>
          <p class="ed-desc">{t.hermesDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.hermesInstall)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.hermesInstall} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.hermesInstall2)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.hermesInstall2} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
        </div>
      </li>

      <!-- Claude Code: two tabs. Without the script both panels show; with it, one at a time. -->
      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.claudeTitle}</h3>
          <p class="ed-desc">{t.claudeDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="gx-abas ed-tabs" role="tablist" aria-label={t.claudeTitle} data-gx-abas>
            <button class="gx-aba" type="button" role="tab" id="ed-tab-desktop" aria-selected="true" aria-controls="ed-panel-desktop">{t.claudeDesktopLabel}</button>
            <button class="gx-aba" type="button" role="tab" id="ed-tab-cli" aria-selected="false" aria-controls="ed-panel-cli">{t.claudeCliLabel}</button>
          </div>
          <!-- Nothing focusable inside, so the panel itself takes the focus (ARIA tabs pattern). -->
          <div class="ed-panel" id="ed-panel-desktop" role="tabpanel" aria-labelledby="ed-tab-desktop" tabindex="0" data-gx-painel>
            <ol class="ed-steps">
              <li>{t.claudeStep1}</li>
              <li>{t.claudeStep2}</li>
              <li><code class="ed-steps-highlight">pe-menezes/vibeflow</code></li>
              <li>{t.claudeStep4}</li>
              <li>{t.claudeStep5}</li>
            </ol>
          </div>
          <div class="ed-panel" id="ed-panel-cli" role="tabpanel" aria-labelledby="ed-tab-cli" data-gx-painel>
            <div class="ed-cmd">
              <code class="ed-cmd-text" set:html={cmdHtml(t.claudeInstall)} />
              <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.claudeInstall} data-copied={t.copied}>{t.copyLabel}</button>
            </div>
            <div class="ed-cmd">
              <code class="ed-cmd-text" set:html={cmdHtml(t.claudeInstall2)} />
              <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.claudeInstall2} data-copied={t.copied}>{t.copyLabel}</button>
            </div>
          </div>
        </div>
      </li>

      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.cursorTitle}</h3>
          <p class="ed-desc">{t.cursorDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.cursorInstall)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.cursorInstall} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
        </div>
      </li>

      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.copilotTitle}</h3>
          <p class="ed-desc">{t.copilotDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.copilotInstall)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.copilotInstall} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
        </div>
      </li>

      <li class="gx-linha ed-row">
        <div class="ed-name">
          <h3>{t.opencodeTitle}</h3>
          <p class="ed-desc">{t.opencodeDesc}</p>
        </div>
        <div class="ed-cmds">
          <div class="ed-cmd">
            <code class="ed-cmd-text" set:html={cmdHtml(t.opencodeInstall)} />
            <button class="gx-btn gx-btn--p ed-copy" type="button" data-copy={t.opencodeInstall} data-copied={t.copied}>{t.copyLabel}</button>
          </div>
        </div>
      </li>
    </ul>

    <div class="ed-notes">
      <p class="ed-note"><InlineCode text={t.editionsLoopKit} /></p>
      <p class="ed-note"><InlineCode text={t.editionsHermesScan} /></p>
      <p class="ed-note"><InlineCode text={t.editionsGitDisclaimer} /></p>
    </div>
    <p class="ed-tag">{t.editionsTagline}</p>
  </div>
</section>

<script>
  // Copy buttons: the exact command is in data-copy, and the feedback, in the page language, in
  // data-copied (both from src/i18n). The Claude Code tabs are wired by the design system script.
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    const label = btn.textContent;
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      } catch {
        return;
      }
      btn.textContent = btn.dataset.copied ?? label;
      clearTimeout(timer);
      timer = window.setTimeout(() => { btn.textContent = label; }, 1500);
    });
  });
</script>

<style>
  .ed-label {
    margin-bottom: var(--s-3);
  }

  /* The three answers: one column on a phone, three where the section is wide enough. The rows
     follow at the distance the subtitle keeps above them. */
  .ed-answers {
    display: grid;
    gap: var(--s-5) var(--s-6);
    margin: 0 0 var(--s-6);
  }
  @media (min-width: 760px) {
    .ed-answers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ed-answers dt {
    color: var(--ink);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .ed-answers dd {
    margin: var(--s-1) 0 0;
    color: var(--ink-3);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .ed-row {
    gap: var(--s-3) var(--s-6);
    align-items: start;
    padding: var(--s-5);
  }
  @media (min-width: 760px) {
    .ed-row {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .ed-name h3 {
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-weight: 500;
    line-height: 1.15;
  }
  .ed-desc {
    max-width: 52ch;
    margin-top: var(--s-1);
    color: var(--ink-3);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .ed-cmds {
    display: grid;
    gap: var(--s-2);
    min-width: 0;
  }
  /* The command keeps its button beside it while both fit; when the longest unbreakable piece
     plus the button does not fit, the button drops below. */
  .ed-cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-2);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-3);
    border-radius: var(--r-2);
    background: var(--bg-alt);
  }
  .ed-cmd-text {
    flex: 1 1 12rem;
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--fs-meta);
  }
  /* Pieces come from set:html, so they carry no scoped attribute. */
  .ed-cmd-text :global(.ed-cmd-part) {
    white-space: nowrap;
  }
  .ed-copy {
    margin-left: auto;
  }

  .ed-tabs {
    margin-bottom: var(--s-1);
  }
  /* The design system's keyboard ring, as on its tabs (.gx-aba:focus-visible). */
  .ed-panel:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .ed-panel + .ed-panel {
    margin-top: var(--s-2);
  }
  .ed-panel .ed-cmd + .ed-cmd {
    margin-top: var(--s-2);
  }
  .ed-steps {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: steps;
  }
  .ed-steps li {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink-2);
    font-size: var(--fs-body);
    line-height: 1.4;
    counter-increment: steps;
  }
  .ed-steps li::before {
    content: counter(steps);
    flex: none;
    width: 1.5em;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
  }
  .ed-steps-highlight {
    padding: 1px var(--s-1);
    border-radius: var(--r-1);
    background: var(--bg-alt);
    user-select: all;
  }

  .ed-notes {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .ed-note {
    max-width: 80ch;
    color: var(--ink-3);
    font-size: var(--fs-ui);
    line-height: 1.6;
  }
  .ed-tag {
    margin-top: var(--s-5);
    color: var(--ink-4);
    font-size: var(--fs-body);
  }
</style>
