---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import InlineCode from './InlineCode.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const artifacts = [
  {
    id: 'index-md',
    name: t.anatomyIndexName,
    tagline: t.anatomyIndexTagline,
    what: t.anatomyIndexWhat,
    why: t.anatomyIndexWhy,
    agent: t.anatomyIndexAgent,
    edit: t.anatomyIndexEdit,
  },
  {
    id: 'patterns',
    name: t.anatomyPatternsName,
    tagline: t.anatomyPatternsTagline,
    what: t.anatomyPatternsWhat,
    why: t.anatomyPatternsWhy,
    agent: t.anatomyPatternsAgent,
    edit: t.anatomyPatternsEdit,
  },
  {
    id: 'conventions-md',
    name: t.anatomyConventionsName,
    tagline: t.anatomyConventionsTagline,
    what: t.anatomyConventionsWhat,
    why: t.anatomyConventionsWhy,
    agent: t.anatomyConventionsAgent,
    edit: t.anatomyConventionsEdit,
  },
  {
    id: 'decisions-md',
    name: t.anatomyDecisionsName,
    tagline: t.anatomyDecisionsTagline,
    what: t.anatomyDecisionsWhat,
    why: t.anatomyDecisionsWhy,
    agent: t.anatomyDecisionsAgent,
    edit: t.anatomyDecisionsEdit,
  },
];

const loopFolders = [
  { name: 'loop/', desc: t.anatomyLoopLedger },
  { name: 'briefings/', desc: t.anatomyLoopBriefings },
  { name: 'progress/', desc: t.anatomyLoopProgress },
  { name: 'reviews/', desc: t.anatomyLoopReviews },
];

const conventionsBullets = [
  t.anatomyVsConventionsBullet1,
  t.anatomyVsConventionsBullet2,
  t.anatomyVsConventionsBullet3,
  t.anatomyVsConventionsBullet4,
];

const patternsBullets = [
  t.anatomyVsPatternsBullet1,
  t.anatomyVsPatternsBullet2,
  t.anatomyVsPatternsBullet3,
  t.anatomyVsPatternsBullet4,
];

// The sections after the four artifacts; together with the artifacts they make the index.
const loopSection = { id: 'loop-folders', title: t.anatomyLoopTitle };
const vsSection = { id: 'patterns-vs-conventions', title: t.anatomyVsTitle };
const manualSection = { id: 'manual', title: t.anatomyCtaTitle };
const toc = [...artifacts.map((a) => ({ id: a.id, title: a.name })), loopSection, vsSection, manualSection];
---

<section class="anatomy">
  <div class="container doc">
    <header class="doc-head">
      <p class="gx-rotulo doc-label">{t.anatomyEyebrow}</p>
      <h1 class="doc-title"><Fragment set:html={t.anatomyTitle} /></h1>
      <p class="doc-lede">{t.anatomySubtitle}</p>
    </header>

    <div class="doc-body">
      <nav class="doc-toc" data-doc-toc aria-label={t.anatomyTocLabel}>
        <p class="gx-rotulo">{t.anatomyTocLabel}</p>
        <ol>
          {toc.map((item) => (
            <li><a href={`#${item.id}`}>{item.title}</a></li>
          ))}
        </ol>
      </nav>

      <div class="doc-main">
        <p class="entry-text doc-intro">{t.anatomyIntro}</p>

        {artifacts.map((a) => (
          <article id={a.id} class="doc-entry">
            <header class="entry-head">
              <h2 class="entry-name">{a.name}</h2>
              <p class="gx-rotulo">{a.tagline}</p>
            </header>

            <dl class="entry-defs">
              <div class="entry-def">
                <dt class="gx-rotulo">{t.anatomyWhatLabel}</dt>
                <dd>{a.what}</dd>
              </div>
              <div class="entry-def">
                <dt class="gx-rotulo">{t.anatomyWhyLabel}</dt>
                <dd>{a.why}</dd>
              </div>
              <div class="entry-def">
                <dt class="gx-rotulo">{t.anatomyAgentLabel}</dt>
                <dd>{a.agent}</dd>
              </div>
              <div class="entry-def">
                <dt class="gx-rotulo">{t.anatomyEditLabel}</dt>
                <dd>{a.edit}</dd>
              </div>
            </dl>
          </article>
        ))}

        <section id={loopSection.id} class="doc-entry">
          <header class="entry-head">
            <h2 class="entry-name">{loopSection.title}</h2>
          </header>
          <p class="entry-text"><InlineCode text={t.anatomyLoopIntro} /></p>
          <ul class="gx-escuro entry-tree">
            <li class="entry-tree-root"><code>.vibeflow/</code></li>
            {loopFolders.map((f) => (
              <li class="entry-tree-branch"><code class="entry-tree-name">{f.name}</code> <span><InlineCode text={f.desc} /></span></li>
            ))}
          </ul>
          <p class="entry-text"><InlineCode text={t.anatomyLoopGit} /></p>
        </section>

        <section id={vsSection.id} class="doc-entry">
          <header class="entry-head">
            <h2 class="entry-name">{vsSection.title}</h2>
          </header>
          <p class="entry-text">{t.anatomyVsIntro}</p>

          <div class="vs">
            <div class="vs-side">
              <h3><code class="gx-chip">{t.anatomyVsConventionsTitle}</code></h3>
              <ul>
                {conventionsBullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
            <div class="vs-side">
              <h3><code class="gx-chip">{t.anatomyVsPatternsTitle}</code></h3>
              <ul>
                {patternsBullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>

          <p class="gx-cit vs-closing">{t.anatomyVsClosing}</p>
        </section>

        <section id={manualSection.id} class="doc-entry">
          <header class="entry-head">
            <h2 class="entry-name">{manualSection.title}</h2>
          </header>
          <p class="entry-text">{t.anatomyCtaText}</p>
          <p class="entry-more">
            <a href={t.anatomyCtaHref} target="_blank" rel="noopener" class="gx-btn gx-btn--primario">{t.anatomyCtaBtn}</a>
          </p>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  // Marks the index link of the entry being read. Without this script the index is a plain list of
  // links and every entry is already on the page; the mark is an accent, never a gate.
  document.querySelectorAll<HTMLElement>('[data-doc-toc]').forEach((toc) => {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (!targets.length || !('IntersectionObserver' in window)) return;
    const inView = new Set<string>();
    const mark = () => {
      const current = targets.find((el) => inView.has(el.id));
      if (!current) return;
      links.forEach((a, id) => {
        if (id === current.id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    // An entry counts as read while any part of it is in the upper part of the viewport.
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? inView.add(e.target.id) : inView.delete(e.target.id)));
        mark();
      },
      { rootMargin: '0px 0px -55% 0px' },
    );
    targets.forEach((el) => observer.observe(el));
  });
</script>

<style>
  /* An editorial document: the head, then an index beside a reading column on wide screens. */
  .doc {
    padding-block: clamp(32px, 5vw, 72px) var(--s-8);
  }

  .doc-head {
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--rule-soft);
  }
  .doc-title {
    max-width: 18ch;
    margin-top: var(--s-3);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    text-wrap: balance;
  }
  .doc-lede {
    max-width: 52ch;
    margin-top: var(--s-4);
    color: var(--ink-3);
    font-size: var(--fs-lede);
    line-height: 1.45;
  }

  .doc-body {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  .doc-main {
    min-width: 0;
    max-width: 50rem;
  }

  /* The index: a wrapped list on top on narrow screens, a sticky column with a rule on wide ones. */
  .doc-toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-3);
    list-style: none;
  }
  .doc-toc a {
    color: var(--ink-3);
    font-size: var(--fs-ui);
    transition: color var(--d-2) var(--ease-out), border-color var(--d-2) var(--ease-out);
  }
  .doc-toc a:hover,
  .doc-toc a[aria-current] {
    color: var(--ink);
  }

  @media (min-width: 980px) {
    .doc-body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: var(--s-8);
      align-items: start;
      margin-top: var(--s-7);
    }
    .doc-toc {
      position: sticky;
      top: var(--s-6);
    }
    .doc-toc ol {
      display: grid;
      gap: 0;
      border-left: 1px solid var(--rule-soft);
    }
    .doc-toc a {
      display: block;
      margin-left: -1px;
      padding: var(--s-1) 0 var(--s-1) var(--s-3);
      border-left: 2px solid transparent;
      line-height: 1.35;
    }
    .doc-toc a[aria-current] {
      border-left-color: var(--accent);
    }
  }

  /* One entry per artifact or section: one idea per block, a rule between them. */
  .doc-intro {
    margin-top: 0;
    padding-bottom: var(--s-7);
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
  .doc-entry {
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule-soft);
    scroll-margin-top: var(--s-5);
  }
  .doc-entry:last-child {
    padding-bottom: 0;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    margin-bottom: var(--s-5);
  }
  .entry-name {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .entry-text {
    max-width: 68ch;
    margin-top: var(--s-4);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .entry-head + .entry-text {
    margin-top: 0;
  }

  /* The four questions of an artifact as definition rows, a rule between them. */
  .entry-def {
    display: grid;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule-soft);
  }
  .entry-def:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  @media (min-width: 720px) {
    .entry-def {
      grid-template-columns: 12rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .entry-def dd {
    max-width: 62ch;
    color: var(--ink-3);
    line-height: 1.6;
  }

  /* The folders the loop creates, as a tree on the dark stage. */
  .entry-tree {
    margin-top: var(--s-5);
    padding: var(--s-5);
    border-radius: var(--r-2);
    font-size: var(--fs-ui);
    line-height: 1.6;
    list-style: none;
  }
  .entry-tree code {
    color: var(--ink-on-deep);
  }
  .entry-tree-root code,
  .entry-tree-name {
    color: var(--accent-on-deep);
    font-weight: 500;
  }
  .entry-tree-branch {
    position: relative;
    margin-left: 0.4em;
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
    border-left: 1px solid var(--rule-on-deep);
    color: var(--ink-5);
  }
  .entry-tree-branch::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    width: var(--s-4);
    height: calc(var(--s-2) + 0.8em);
    border-bottom: 1px solid var(--rule-on-deep);
    border-left: 1px solid var(--rule-on-deep);
  }
  .entry-tree-branch:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  /* Conventions beside patterns: two lists split by a rule, no boxes. */
  .vs {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  @media (min-width: 720px) {
    .vs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }
    .vs-side + .vs-side {
      padding-left: var(--s-5);
      border-left: 1px solid var(--rule-soft);
    }
    .vs-side:first-child {
      padding-right: var(--s-5);
    }
  }
  .vs-side h3 {
    margin-bottom: var(--s-3);
    font-weight: 400;
  }
  .vs-side ul {
    list-style: none;
  }
  .vs-side li {
    padding-block: var(--s-2);
    border-top: 1px solid var(--rule-soft);
    color: var(--ink-3);
    line-height: 1.5;
  }
  .vs-side li:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  .vs-closing {
    margin-top: var(--s-6);
  }

  .entry-more {
    margin-top: var(--s-5);
  }
</style>
