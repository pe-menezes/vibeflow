---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="container">
  <div class="footer">
    <p class="footer-copy">&copy; 2026 Vibeflow &middot; {t.footerLicense}</p>
    <p class="footer-links">
      <a class="gx-link" href="https://github.com/pe-menezes/vibeflow" target="_blank" rel="noopener">{t.headerGithub}</a>
      <a class="gx-link" href="https://www.npmjs.com/package/setup-vibeflow" target="_blank" rel="noopener">npm</a>
      <a class="gx-link" href={`/${lang}/commands`}>{t.navCommands}</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-5);
    margin-top: clamp(64px, 10vw, 120px);
    padding-block: var(--s-4) var(--s-7);
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: var(--fs-meta);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
</style>
