---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import InlineCode from './InlineCode.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- The three answers (cost, code, first command) and the three notes of the editions, at the end
     of the commands page since the home page lists only the agents and their commands. Same keys,
     same markup and same look as they had under the edition rows. -->
<section class="section edition-answers" id="edition-answers">
  <div class="container">
    <p class="gx-rotulo ea-label">{t.editionsLabel}</p>

    <!-- Titles are dt, not headings: the block adds no title of its own. -->
    <dl class="ed-answers">
      <div class="ed-answer">
        <dt>{t.editionsCostTitle}</dt>
        <dd><InlineCode text={t.editionsCostBody} /></dd>
      </div>
      <div class="ed-answer">
        <dt>{t.editionsCodeTitle}</dt>
        <dd><InlineCode text={t.editionsCodeBody} /></dd>
      </div>
      <div class="ed-answer">
        <dt>{t.editionsFirstTitle}</dt>
        <dd><InlineCode text={t.editionsFirstBody} /></dd>
      </div>
    </dl>

    <div class="ed-notes">
      <p class="ed-note"><InlineCode text={t.editionsLoopKit} /></p>
      <p class="ed-note"><InlineCode text={t.editionsHermesScan} /></p>
      <p class="ed-note"><InlineCode text={t.editionsGitDisclaimer} /></p>
    </div>
  </div>
</section>

<style>
  .edition-answers {
    padding-top: clamp(64px, 10vw, 136px);
  }
  .ea-label {
    margin-bottom: var(--s-3);
  }

  /* The three answers: one column on a phone, three where the section is wide enough. */
  .ed-answers {
    display: grid;
    gap: var(--s-5) var(--s-6);
    margin: 0;
  }
  @media (min-width: 760px) {
    .ed-answers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ed-answers dt {
    color: var(--ink);
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: 1.4;
  }
  .ed-answers dd {
    margin: var(--s-1) 0 0;
    color: var(--ink-3);
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  .ed-notes {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .ed-note {
    max-width: 80ch;
    color: var(--ink-3);
    font-size: var(--fs-ui);
    line-height: 1.6;
  }
</style>
