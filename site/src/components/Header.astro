---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const github = 'https://github.com/pe-menezes/vibeflow';
// The mark: a V whose left arm is a wave and whose right arm is straight; public/favicon.svg
// draws the same path.
---

<header class="site-header" id="header">
  <div class="container header-inner">
    <a class="brand" href={`/${lang}/`}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path class="brand-path" d="M4.50 6.00 L5.80 6.26 L6.88 6.65 L7.56 7.25 L7.78 8.10 L7.60 9.18 L7.16 10.39 L6.70 11.62 L6.44 12.74 L6.53 13.66 L7.05 14.35 L7.95 14.84 L9.08 15.19 L10.25 15.52 L11.27 15.94 L11.98 16.53 L12.34 17.30 L12.40 18.25 L12.27 19.29 L12.13 20.35 L12.11 21.33 L12.33 22.19 L12.78 22.91 L13.42 23.54 L14.13 24.13 L14.79 24.74 L15.33 25.42 L15.71 26.18 L16.00 27.00 L27.5 6" /></svg>
      <span>Vibeflow</span>
    </a>

    <nav class="nav desktop-only">
      <a href={`/${lang}/#how`}>{t.navHow}</a>
      <a href={`/${lang}/commands`}>{t.navCommands}</a>
      <a href={`/${lang}/anatomy`}>{t.navAnatomy}</a>
      <a href={`/${lang}/#editions`}>{t.navInstall}</a>
      <a href={github} target="_blank" rel="noopener">{t.headerGithub}</a>
    </nav>

    <div class="tools">
      <a href={t.switchPath} class="gx-btn gx-btn--fantasma gx-btn--p lang-toggle">{t.switchLang}</a>
      <button class="gx-btn gx-btn--fantasma gx-btn--p theme-toggle" aria-label="Toggle theme" type="button">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href={github} target="_blank" rel="noopener" class="gx-btn gx-btn--p desktop-only">{t.navStarGithub}</a>
      <button class="gx-btn gx-btn--fantasma gx-btn--p hamburger mobile-only" id="hamburger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu container" id="mobile-menu" hidden>
    <a href={`/${lang}/#how`}>{t.navHow}</a>
    <a href={`/${lang}/commands`}>{t.navCommands}</a>
    <a href={`/${lang}/anatomy`}>{t.navAnatomy}</a>
    <a href={`/${lang}/#editions`}>{t.navInstall}</a>
    <a href={github} target="_blank" rel="noopener">{t.headerGithub}</a>
    <a href={github} target="_blank" rel="noopener" class="gx-btn gx-btn--primario">{t.navStarGithub}</a>
  </nav>
</header>

<script>
  import { nextTheme } from '../lib/theme.js';

  // Theme: the choice is saved either way and wins over the system until changed again.
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  document.querySelectorAll('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const next = nextTheme(html.dataset.theme, systemDark.matches);
      html.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Private mode: the choice holds for this page only.
      }
    });
  });

  // Mobile menu
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  if (hamburger && mobileMenu) {
    const setOpen = (open: boolean) => {
      hamburger.setAttribute('aria-expanded', String(open));
      mobileMenu.hidden = !open;
    };
    hamburger.addEventListener('click', () => setOpen(mobileMenu.hidden));
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.14rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand svg {
    width: 30px;
    height: 30px;
    overflow: visible;
  }
  .brand-path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav {
    display: flex;
    gap: var(--s-5);
    font-size: var(--fs-ui);
  }
  .nav a {
    color: var(--ink-3);
    text-decoration: none;
    transition: color var(--d-2) var(--ease-out);
  }
  .nav a:hover {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .lang-toggle {
    font-family: var(--font-mono);
    font-size: var(--fs-data);
  }

  .theme-toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The icon shows the theme the button switches to. */
  .icon-sun { display: none; }
  .icon-moon { display: block; }
  :global(:root[data-theme="dark"]) .icon-sun { display: block; }
  :global(:root[data-theme="dark"]) .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .icon-sun { display: block; }
    :global(:root:not([data-theme="light"])) .icon-moon { display: none; }
  }

  .hamburger {
    flex-direction: column;
    gap: 4px;
    width: var(--ctl-p);
  }
  .hamburger span {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule-soft);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu a:not(.gx-btn) {
    padding-block: var(--s-1);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 859px) {
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: inline-flex;
    }
  }
</style>
