---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cases = [
  { title: t.uc1Title, role: t.uc1Role, desc: t.uc1Desc, flow: t.uc1Flow },
  { title: t.uc2Title, role: t.uc2Role, desc: t.uc2Desc, flow: t.uc2Flow },
  { title: t.uc3Title, role: t.uc3Role, desc: t.uc3Desc, flow: t.uc3Flow },
  { title: t.uc4Title, role: t.uc4Role, desc: t.uc4Desc, flow: t.uc4Flow },
];
---

<section class="section use-cases" id="use-cases">
  <div class="container">
    <div class="section-head">
      <p class="gx-rotulo">{t.useCasesLabel}</p>
      <h2 class="section-title">{t.useCasesTitle2}</h2>
      <p class="section-sub">{t.useCasesSubtitle2}</p>
    </div>

    <ul class="uc-list">
      {cases.map((uc) => (
        <li class="uc-row">
          <p class="gx-rotulo">{uc.role}</p>
          <div>
            <h3>{uc.title}</h3>
            <p>{uc.desc}</p>
          </div>
          <p class="uc-route">
            {uc.flow.split(' → ').map((step, i, arr) => (
              <>
                <code>{step}</code>
                {i < arr.length - 1 && <span class="uc-arrow" aria-hidden="true">→</span>}
              </>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .use-cases {
    padding-top: clamp(64px, 10vw, 136px);
  }
  .section-head .gx-rotulo {
    margin-bottom: var(--s-3);
  }

  .uc-list {
    padding: 0;
    list-style: none;
  }
  .uc-row {
    display: grid;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule-soft);
  }
  .uc-row:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  .uc-row h3 {
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-weight: 500;
    line-height: 1.15;
  }
  .uc-row div p {
    max-width: 60ch;
    margin-top: var(--s-2);
    color: var(--ink-3);
  }

  /* The route of commands: real arrows between the steps, so the text reads as it does today. */
  .uc-route {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--fs-meta);
  }
  .uc-route code {
    padding: 2px var(--s-2);
    border-radius: var(--r-1);
    background: var(--bg-alt);
    color: var(--ink-2);
  }
  .uc-arrow {
    color: var(--ink-4);
  }

  @media (min-width: 900px) {
    .uc-row {
      grid-template-columns: 150px minmax(0, 1fr) minmax(0, 290px);
      align-items: baseline;
    }
  }
</style>
