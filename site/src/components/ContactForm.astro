---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const FORMSPREE_ID = 'xgonvawy';
---

<section class="section contact" id="contact">
  <div class="container contact-grid">
    <div class="section-head">
      <p class="gx-rotulo">{t.contactTitle}</p>
      <h2 class="section-title">{t.contactHeading}</h2>
      <p class="section-sub">{t.contactSubtitle}</p>
    </div>

    <div>
      <!-- The wrapper is what hides once the message is sent: the form itself is a grid. -->
      <div id="contact-body">
        <form class="contact-form" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST" id="contact-form">
          <label class="gx-campo" for="c-name">
            <span class="gx-campo__rotulo">{t.contactName}</span>
            <input class="gx-campo__entrada" type="text" id="c-name" name="name" placeholder={t.contactNamePlaceholder} required />
          </label>
          <label class="gx-campo" for="c-email">
            <span class="gx-campo__rotulo">{t.contactEmail}</span>
            <input class="gx-campo__entrada" type="email" id="c-email" name="email" placeholder={t.contactEmailPlaceholder} required />
          </label>
          <label class="gx-campo contact-wide" for="c-msg">
            <span class="gx-campo__rotulo">{t.contactMessage}</span>
            <textarea class="gx-campo__entrada" id="c-msg" name="message" placeholder={t.contactMessagePlaceholder} required></textarea>
          </label>
          <button class="gx-btn gx-btn--primario contact-submit" type="submit" data-sending={t.contactSending}>{t.contactSend}</button>
        </form>
        <!-- Empty until a send fails: the script writes the message in, so the change is announced. -->
        <p class="contact-error" id="form-error" role="alert" data-message={t.contactError}></p>
      </div>
      <p class="contact-success" id="form-success" role="status" tabindex="-1" hidden>{t.contactSuccess}</p>
    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactBody = document.getElementById('contact-body');
  const formSuccess = document.getElementById('form-success');
  const formError = document.getElementById('form-error');
  if (contactForm && contactBody && formSuccess && formError) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector('.contact-submit') as HTMLButtonElement;
      const origText = btn.textContent;
      btn.textContent = btn.dataset.sending ?? origText;
      btn.disabled = true;
      // Cleared on every send, so the next failure changes the region and is announced again.
      formError.textContent = '';
      let sent = false;
      try {
        const res = await fetch(contactForm.action, {
          method: 'POST',
          body: new FormData(contactForm),
          headers: { 'Accept': 'application/json' }
        });
        sent = res.ok;
      } catch {
        sent = false;
      }
      if (sent) {
        contactBody.hidden = true;
        formSuccess.hidden = false;
        formSuccess.focus();
      } else {
        // The fields keep what was typed; only the button and the message change.
        btn.textContent = origText;
        btn.disabled = false;
        formError.textContent = formError.dataset.message ?? '';
      }
    });
  }
</script>

<style>
  .contact {
    padding-block: clamp(64px, 10vw, 136px);
  }
  .section-head .gx-rotulo {
    margin-bottom: var(--s-3);
  }

  .contact-grid {
    display: grid;
    gap: var(--s-6);
  }
  .contact-form {
    display: grid;
    gap: var(--s-4);
  }
  .contact-form textarea {
    min-height: 140px;
    resize: vertical;
  }
  .contact-submit {
    justify-self: start;
  }
  .contact-success {
    padding-block: var(--s-5);
    color: var(--pos);
    font-size: var(--fs-lede);
  }
  .contact-error {
    color: var(--neg);
    font-size: var(--fs-body);
  }
  .contact-error:not(:empty) {
    margin-top: var(--s-4);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--s-8);
      align-items: start;
    }
    .contact-form {
      grid-template-columns: 1fr 1fr;
    }
    .contact-wide,
    .contact-submit {
      grid-column: 1 / -1;
    }
  }
</style>
