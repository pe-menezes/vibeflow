---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const commands = [
  { id: 'analyze', tier: 'Core', title: t.feat1Title, desc: t.feat1Desc, forLabel: t.feat1For, highlights: t.feat1Highlights },
  { id: 'gen-spec', tier: 'Core', title: t.feat2Title, desc: t.feat2Desc, forLabel: t.feat2For, highlights: t.feat2Highlights },
  { id: 'implement', tier: 'Core', title: t.feat3Title, desc: t.feat3Desc, forLabel: t.feat3For, highlights: t.feat3Highlights },
  { id: 'audit', tier: 'Core', title: t.feat4Title, desc: t.feat4Desc, forLabel: t.feat4For, highlights: t.feat4Highlights },
  { id: 'discover', tier: 'Tool', title: t.feat5Title, desc: t.feat5Desc, forLabel: t.feat5For, highlights: t.feat5Highlights },
  { id: 'prompt-pack', tier: 'Tool', title: t.feat6Title, desc: t.feat6Desc, forLabel: t.feat6For, highlights: t.feat6Highlights },
  { id: 'quick', tier: 'Tool', title: t.feat7Title, desc: t.feat7Desc, forLabel: t.feat7For, highlights: t.feat7Highlights },
  { id: 'hotfix', tier: 'Tool', title: t.feat10Title, desc: t.cmdHotfixDesc, forLabel: t.feat10For, highlights: t.feat10Highlights },
  { id: 'teach', tier: 'Tool', title: t.feat8Title, desc: t.feat8Desc, forLabel: t.feat8For, highlights: t.feat8Highlights },
  { id: 'stats', tier: 'Tool', title: t.feat9Title, desc: t.feat9Desc, forLabel: t.feat9For, highlights: t.feat9Highlights },
];
---

<section class="section commands" id="commands">
  <div class="container">
    <div class="section-head">
      <p class="gx-rotulo">{t.cmdLabel}</p>
      <h2 class="section-title">{t.cmdGridTitle}</h2>
      <p class="section-sub">{t.featuresSubtitle}</p>
    </div>

    <ul class="cmd-list">
      {commands.map((cmd) => (
        <li class="cmd-row">
          <div class="cmd-name">
            <h3><a class="gx-link gx-link--titulo" href={`/${lang}/commands#${cmd.id}`}>{cmd.title}</a></h3>
            <p class={`cmd-tier cmd-tier--${cmd.tier.toLowerCase()}`}>{cmd.tier}</p>
          </div>
          <div>
            <p class="gx-rotulo">{cmd.forLabel}</p>
            <p class="cmd-desc">{cmd.desc}</p>
          </div>
          <div class="cmd-side">
            <p class="cmd-flags">
              {cmd.highlights.map((h: string) => <span class="gx-chip">{h}</span>)}
            </p>
            {/* A mouse shortcut to the title's own target: the title link is the one read and reached. */}
            <a class="gx-link cmd-details" href={`/${lang}/commands#${cmd.id}`} aria-hidden="true" tabindex="-1">{t.cmdDetails}</a>
          </div>
        </li>
      ))}
    </ul>

    <p class="cmd-more">
      <a class="gx-link" href={`/${lang}/commands`}>{t.cmdFullRef}</a>
    </p>
  </div>
</section>

<style>
  .commands {
    padding-top: clamp(64px, 10vw, 136px);
  }
  .section-head .gx-rotulo {
    margin-bottom: var(--s-3);
  }

  .cmd-list {
    padding: 0;
    list-style: none;
  }
  .cmd-row {
    display: grid;
    gap: var(--s-2) var(--s-6);
    align-items: baseline;
    padding-block: var(--s-4);
    border-top: 1px solid var(--rule-soft);
  }
  .cmd-row:last-child {
    border-bottom: 1px solid var(--rule-soft);
  }
  .cmd-name h3 {
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-style: italic;
    font-weight: 400;
  }
  .cmd-tier {
    margin-top: var(--s-1);
    color: var(--ink-4);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cmd-tier--core {
    color: var(--accent-text);
  }
  .cmd-desc {
    max-width: 58ch;
    margin-top: var(--s-1);
    color: var(--ink-3);
    font-size: var(--fs-ui);
  }
  .cmd-side {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }
  .cmd-flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
  }
  .cmd-details {
    font-size: var(--fs-meta);
  }
  .cmd-more {
    margin-top: var(--s-6);
  }

  @media (min-width: 900px) {
    .cmd-row {
      grid-template-columns: 170px minmax(0, 1fr) minmax(0, 290px);
    }
  }
</style>
