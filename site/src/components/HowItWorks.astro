---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { PIPELINE_GATES } from '../lib/flow.js';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Each step: the command and what it does. The gates sit where pipelineGeometry() in
// src/lib/flow.js orders the lines.
const steps = [
  { title: t.step1Title, desc: t.pipelineStep1Desc },
  { title: t.step2Title, desc: t.pipelineStep2Desc },
  { title: t.step3Title, desc: t.pipelineStep3Desc },
  { title: t.step4Title, desc: t.pipelineStep4Desc },
].map((step, i) => ({ ...step, gate: `${(PIPELINE_GATES[i] * 100).toFixed(0)}%` }));

// The verdict past the last gate: the first sentence of the audit output ("PASS").
const verdict = t.heroQuickStart4Desc.split('.')[0];
---

<section class="pipe" id="how" data-pipeline-scene>
  <!-- The ruler: as tall as the pinned stage, read by the script's measure (src/lib/pipeline-scene.js). -->
  <div class="pipe-ruler" data-scene-ruler aria-hidden="true"></div>
  <div class="pipe-track" data-scene-track>
    <div class="container pipe-stage" data-scene-stage>
      <div class="pipe-head">
        <div class="pipe-head__title">
          <p class="gx-rotulo">{t.pipelineLabel}</p>
          <h2 class="section-title pipe-title" set:html={t.howTitle} />
        </div>
      </div>

      <div class="pipe-band" data-scene-band role="img" aria-label={t.pipelineFlowLabel}>
        <canvas class="pipe-canvas" data-flow="pipeline" aria-hidden="true"></canvas>
        {steps.map((step) => (
          <span class="pipe-gate" data-gate data-active="true" style={`left: ${step.gate}`} aria-hidden="true">{step.title}</span>
        ))}
        <span class="gx-chip gx-chip--marcado pipe-end" data-scene-end aria-hidden="true">{verdict}</span>
      </div>

      <ol class="pipe-steps">
        {steps.map((step) => (
          <li class="pipe-step" data-step data-active="true">
            <h3 class="pipe-step__cmd"><span>{step.title}</span></h3>
            <p class="pipe-step__desc">{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Below the track and out of the pinned stage, so the stage only holds what the scene moves. -->
  <p class="container pipe-extra">
    <a href={`/${lang}/commands`} class="pipe-link">{t.featSeeAll}</a>
  </p>
</section>

<script>
  import { createFlow } from '../lib/flow.js';
  import { bindPipelineScene } from '../lib/pipeline-scene.js';

  document.querySelectorAll<HTMLElement>('[data-pipeline-scene]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas[data-flow="pipeline"]');
    if (canvas) bindPipelineScene(root, createFlow(canvas));
  });
</script>

<style>
  .pipe {
    padding-top: clamp(64px, 10vw, 136px);
  }
  .pipe-stage {
    display: grid;
    gap: clamp(20px, 3.4vh, 40px);
  }
  .pipe-head,
  .pipe-head__title {
    display: grid;
    gap: var(--s-3);
  }
  .pipe-title {
    margin-bottom: 0;
  }

  /* The band: the canvas, the four gates on top of their wires and the verdict past the last one. */
  .pipe-band {
    position: relative;
    height: clamp(180px, 30vh, 320px);
  }
  .pipe-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .pipe-gate {
    position: absolute;
    top: 0;
    padding: 2px var(--s-2);
    border: 1px solid var(--accent);
    border-radius: var(--r-1);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    white-space: nowrap;
    transform: translateX(-50%);
    transition:
      background-color var(--d-3) var(--ease-out),
      color var(--d-3) var(--ease-out),
      border-color var(--d-3) var(--ease-out);
  }
  .pipe-gate[data-active="false"] {
    border-color: var(--rule-soft);
    background: var(--bg);
    color: var(--ink-4);
  }
  .pipe-end {
    position: absolute;
    top: 54%;
    right: 0;
    transform: translateY(-50%);
  }

  /* The steps: lit at rest; the scene dims all but the current one while it is pinned. */
  .pipe-steps {
    display: grid;
    gap: var(--s-5);
    padding: 0;
    list-style: none;
  }
  .pipe-step {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-3);
    border-top: 1px solid var(--ink);
    color: var(--ink-2);
    transition:
      color var(--d-3) var(--ease-out),
      border-color var(--d-3) var(--ease-out);
  }
  .pipe-step__cmd {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
    transition: color var(--d-3) var(--ease-out);
  }
  .pipe-step__cmd span {
    background: linear-gradient(var(--accent-halo), var(--accent-halo)) no-repeat 0 82% / 100% 0.46em;
    transition: background-size var(--d-4) var(--ease-swap);
  }
  .pipe-step__desc {
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .pipe-step[data-active="false"] {
    border-top-color: var(--rule-soft);
    color: var(--ink-4);
  }
  .pipe-step[data-active="false"] .pipe-step__cmd {
    color: var(--ink-3);
  }
  .pipe-step[data-active="false"] .pipe-step__cmd span {
    background-size: 0% 0.46em;
  }
  @media (min-width: 860px) {
    .pipe-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pipe-extra {
    margin-top: var(--s-5);
    color: var(--ink-4);
    font-size: var(--fs-meta);
  }
  .pipe-link {
    font-weight: 500;
  }

  /* The ruler has no box where the scene does not pin. */
  .pipe-ruler {
    display: contents;
  }

  /* The timeline by scroll exists only on a wide, tall screen with motion allowed and the script
     running (html.motion-ok), and only while the stage fits the screen: when it does not, the
     script marks the section [data-scene-loose] (src/lib/pipeline-scene.js). Anywhere else the
     section runs as a normal one. */
  @media (min-width: 860px) and (min-height: 660px) and (prefers-reduced-motion: no-preference) {
    /* The same pinned or loose, so the script's measure of the stage gives one answer. */
    :global(html.motion-ok) .pipe-stage {
      padding-block: clamp(16px, 4vh, 48px);
    }
    :global(html.motion-ok) .pipe-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--s-8);
    }
    /* The size of the step descriptions where the scene can pin: one declaration, the same pinned
       or loose, so the stage keeps fitting the screens it pins on. */
    :global(html.motion-ok) .pipe-step__desc {
      font-size: var(--fs-ui);
    }
    /* Pinned: the stage is the screen, the band takes what the head and the steps leave, from
       BAND_MIN to BAND_MAX (src/lib/pipeline-scene.js), and what is left past that is shared
       above and below the three, so they sit in the middle of the screen. */
    :global(html.motion-ok) .pipe:not([data-scene-loose]) .pipe-track {
      height: 330vh;
      height: 330svh;
    }
    :global(html.motion-ok) .pipe:not([data-scene-loose]) .pipe-stage {
      position: sticky;
      top: 0;
      grid-template-rows: auto minmax(150px, 420px) auto;
      align-content: safe center;
      height: 100vh;
      height: 100svh;
    }
    :global(html.motion-ok) .pipe:not([data-scene-loose]) .pipe-band {
      height: auto;
    }
    /* The ruler: the declared height of the pinned stage, pinned or loose, so the script measures
       the content against the height the stage has. Fixed and with no width, it draws nothing,
       moves no other node and adds nothing to the scroll. */
    :global(html.motion-ok) .pipe-ruler {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 0;
      height: 100vh;
      height: 100svh;
      visibility: hidden;
      pointer-events: none;
    }
  }
</style>
