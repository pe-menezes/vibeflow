---
import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import InlineCode from './InlineCode.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The thesis has a line break; its second line ("does not approve it.") carries the strike.
const [titleFirst, titleSecond] = t.loopTitle.split(/<br\s*\/?>/);

const steps = [
  { title: t.loopStep1Title, desc: t.loopStep1Desc },
  { title: t.loopStep2Title, desc: t.loopStep2Desc },
  { title: t.loopStep3Title, desc: t.loopStep3Desc },
  { title: t.loopStep4Title, desc: t.loopStep4Desc },
  { title: t.loopStep5Title, desc: t.loopStep5Desc },
];

const blocks = [
  { title: t.loopOnTitle, items: t.loopOnItems },
  { title: t.loopHostsTitle, items: t.loopHostsItems },
  { title: t.loopCompanyTitle, items: t.loopCompanyItems },
  { title: t.loopReqTitle, items: t.loopReqItems },
];
---

<section class="gx-escuro loop" id="loop" data-loop>
  <div class="container loop-inner">
    <div class="loop-head">
      <div>
        <p class="gx-rotulo">{t.loopLabel}</p>
        <h2 class="loop-title">
          {titleFirst}{titleSecond !== undefined && <><br /><span class="loop-strike">{titleSecond}</span></>}
        </h2>
      </div>
      <p class="loop-sub"><InlineCode text={t.loopSubtitle} /></p>
    </div>

    <ol class="loop-steps">
      {steps.map((step, i) => (
        <li class="loop-step">
          <span class="loop-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p><InlineCode text={step.desc} /></p>
        </li>
      ))}
    </ol>

    <div class="loop-lists">
      {blocks.map((block) => (
        <div class="loop-list">
          <h3>{block.title}</h3>
          <ul>
            {block.items.map((item: string) => (
              <li><InlineCode text={item} /></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="loop-more">
      <a href={t.loopMoreHref} target="_blank" rel="noopener" class="gx-link">{t.loopMore}</a>
    </p>
  </div>
</section>

<script>
  // The strike under the thesis runs once, when the stage comes into view. At rest, and without
  // this script, it is already drawn.
  const stages = document.querySelectorAll<HTMLElement>('[data-loop]');
  if ('IntersectionObserver' in window) {
    const watch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-seen');
        watch.unobserve(e.target);
      }
    }, { threshold: 0.35 });
    stages.forEach((el) => watch.observe(el));
  } else {
    stages.forEach((el) => el.classList.add('is-seen'));
  }
</script>

<style>
  .loop {
    margin-top: clamp(64px, 10vw, 136px);
    padding-block: clamp(56px, 9vw, 120px);
  }
  .loop-inner {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
  }

  .loop-head {
    display: grid;
    gap: var(--s-5) var(--s-8);
    align-items: end;
  }
  .loop-title {
    max-width: 14ch;
    margin-top: var(--s-4);
    color: var(--ink-on-deep);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.4vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-wrap: balance;
  }
  /* The strike: a thin band of the accent under the second line. Drawn at rest; with motion
     allowed it runs once when the stage is seen. */
  .loop-strike {
    background: linear-gradient(var(--accent-on-deep), var(--accent-on-deep)) no-repeat 0 96% / 100% 0.08em;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion-ok) .loop-strike {
      transition: background-size var(--d-5) var(--ease-swap) var(--d-2);
    }
    :global(html.motion-ok) .loop:not(.is-seen) .loop-strike {
      background-size: 0% 0.08em;
    }
  }
  .loop-sub {
    max-width: 46ch;
    font-size: var(--fs-lede);
    line-height: 1.45;
  }
  @media (min-width: 860px) {
    .loop-head {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  /* The five steps: one numbered sequence in a row, joined by a rule on top. */
  .loop-steps {
    display: grid;
    gap: var(--s-5);
    padding: 0;
    list-style: none;
  }
  .loop-step {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule-on-deep);
  }
  .loop-num {
    color: var(--accent-on-deep);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
  }
  .loop-step h3 {
    color: var(--ink-on-deep);
    font-family: var(--font-display);
    font-size: var(--fs-d3);
    font-weight: 500;
    line-height: 1.15;
  }
  .loop-step p {
    font-size: var(--fs-ui);
    line-height: 1.5;
  }
  @media (min-width: 720px) {
    .loop-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .loop-steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Turning it on, the hosts, company mode and the requirements: plain lists, no card. */
  .loop-lists {
    display: grid;
    gap: var(--s-6) var(--s-7);
  }
  .loop-list h3 {
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule-on-deep);
    color: var(--ink-on-deep);
    font-size: var(--fs-body);
    font-weight: 600;
  }
  .loop-list ul {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
    padding-left: 1.1rem;
    color: var(--ink-5);
    font-size: var(--fs-ui);
    line-height: 1.55;
  }
  .loop-list li::marker {
    color: var(--accent-on-deep);
  }
  @media (min-width: 860px) {
    .loop-lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .loop-more {
    font-size: var(--fs-ui);
  }
</style>
